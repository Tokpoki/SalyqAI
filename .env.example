# === Salyq AI ===

# LLM Provider
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=openai

# JWT Auth
JWT_SECRET=change-me-to-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Database (auto-created inside Docker volume)
DB_PATH=/data/salyq.db

# ChromaDB
CHROMA_PATH=/data/chroma
CHROMA_COLLECTION=rk_tax_code_2026_articles_e5_large

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000
